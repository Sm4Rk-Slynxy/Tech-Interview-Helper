# Copy this file to ".env" and fill in your key.
# Only needed for the built-in Anthropic provider.
# Local providers (Ollama, LM Studio, vLLM, Unsloth) and OpenRouter do not use this.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the proxy port (must match vite.config.js proxy target).
# PROXY_PORT=8787
